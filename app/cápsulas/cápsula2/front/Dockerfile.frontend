# --- Etapa 1: Dependencias ---
FROM node:18-alpine AS deps
# Necesario para Alpine
RUN apk add --no-cache libc6-compat
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

# --- Etapa 2: Construcción (Builder) ---
FROM node:18-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Recibimos la variable desde GitHub Actions
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

# Construimos el proyecto
RUN npm run build

# --- Etapa 3: Ejecución (Runner) ---
FROM node:18-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
# Cloud Run espera puerto 8080
ENV PORT=8080

# Creamos usuario no-root por seguridad
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copiamos SOLO lo necesario para el modo Standalone
# (Esto requiere output: 'standalone' en next.config.js)
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 8080

# En modo standalone, ejecutamos server.js directamente, no npm start
CMD ["node", "server.js"]